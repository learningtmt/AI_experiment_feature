OPENAI_API_KEY=
OPENAI_BASE_URL=            # để trống nếu dùng mặc định
MODEL_ID=gpt-6-luna
PORT=3000
EXPERIMENT_PROMPT_VARIANT=vi   # vi | en
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_MS=240000
ENABLE_CHECKER=true
LLM_MOCK=0                  # 1 = không gọi model thật, dùng đầu ra giả (xem mục LLM_MOCK)
DATA_PROVIDER=mock          # mock | real (real chưa cài đặt)
# TEMPERATURE=  MAX_OUTPUT_TOKENS=   (chỉ đặt khi cần, mặc định không gửi)
